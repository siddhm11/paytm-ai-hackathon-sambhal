# Copy to .env and fill in. Everything is optional: with no keys the demo runs on rules + templates.

# Sarvam AI (dashboard.sarvam.ai): voice in and out, and the default LLM
SARVAM_API_KEY=

# LLM for understanding free-form replies: sarvam | openai | anthropic | none
# LLM_PROVIDER=sarvam
# LLM_MODEL=sarvam-105b
# LLM_REASONING_EFFORT=low
#
# OpenAI-compatible example (OpenAI, Gemini, Groq...):
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
#
# Anthropic example:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-haiku-4-5

# 1 = let the LLM rephrase approved messages (each one is checked). Keep 0 for the stage demo.
LLM_REWRITE=0

# Voice
TTS_SPEAKER=priya
# STT_MODEL=saaras:v4
# TTS_MODEL=bulbul:v3

# 1 = never touch the network (rules, templates, cached audio)
OFFLINE=0
